# Copy to web/.env.local for local development. On Netlify, set these as environment variables.
# Supabase dashboard → Project Settings → API. The anon/publishable key is public by design (RLS protects data).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
